# Application Site URLs (for OAuth redirects and callbacks)
VITE_SITE_URL="https://krivio-ai.vercel.app"
NEXT_PUBLIC_SITE_URL="https://krivio-ai.vercel.app"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://krivio-ai.vercel.app"

# Supabase Auth Configuration (Client-safe public anon credentials)
VITE_SUPABASE_URL="https://mvbpxcsyyasckzymjyjb.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
NEXT_PUBLIC_SUPABASE_URL="https://mvbpxcsyyasckzymjyjb.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# Supabase JWT Secret for verifying auth token signatures on the backend
SUPABASE_JWT_SECRET="your_supabase_jwt_secret_here"

# JWT Secret for Auth Token Signatures
JWT_SECRET="krivio_secret_key_change_in_production"

# Razorpay credentials for Payments / Subscriptions
RAZORPAY_KEY_ID="rzp_test_krivio123"
RAZORPAY_KEY_SECRET="krivio_razorpay_secret_123"

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/krivio_db"

# Meta WhatsApp Cloud API Configuration (Phase 2)
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_or_permanent_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_VERIFY_TOKEN="your_custom_secure_verify_token_for_meta_webhook"
WHATSAPP_APP_SECRET="your_meta_app_secret_for_signature_verification"
WHATSAPP_GRAPH_API_VERSION="v21.0"

# Google Cloud Speech-to-Text V2 / Chirp 2 Configuration (Phase 2)
GOOGLE_CLOUD_PROJECT="your_google_cloud_project_id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"


