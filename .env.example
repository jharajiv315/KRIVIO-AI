# ==============================================================================
# KRIVIO AI — PRODUCTION ENVIRONMENT CONFIGURATION SPECIFICATION
# ==============================================================================
# NOTE: Never commit sensitive production credentials or .env to version control.
# Copy this file to .env for local development.

# ==============================================================================
# SECTION 1: VERCEL FRONTEND CONFIGURATION (Client-Safe / Build-Time Variables)
# Configure these variables in: Vercel Project Settings -> Environment Variables
# ==============================================================================

# Base URL of the dedicated backend service (Render Web Service or self-hosted API)
# Leave empty if deploying backend directly on Vercel Serverless under /api
VITE_API_URL="https://krivio-backend.onrender.com"

# Application public domain (used for OAuth redirects, canonical links, and CORS)
VITE_SITE_URL="https://krivio-ai.vercel.app"
NEXT_PUBLIC_SITE_URL="https://krivio-ai.vercel.app"

# Public Supabase Client Credentials (Safe to expose to frontend client builds)
