VITE_RAZORPAY_KEY_ID="rzp_test_krivio123"

# ==============================================================================
# SECTION 2: RENDER BACKEND CONFIGURATION (Server-Only Secrets)
# Configure these variables in: Render Dashboard -> Environment -> Secret Files / Env
# DO NOT expose these to Vercel client-side bundles!
# ==============================================================================

# Server Environment & Port Configuration
ENVIRONMENT="production"
PORT=10000
NODE_ENV="production"

# PostgreSQL Database Connection String (Supabase Connection Pooler or Direct)
# For Supabase, use port 6543 (PgBouncer Transaction Pooler) with sslmode=require
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_SSL_REQUIRE="true"

# Google Gemini API Key (Required for Multimodal AI, Voice Mentor & Image Analysis)
GEMINI_API_KEY="AIzaSyYourProductionGeminiApiKey"

# Supabase Auth Secret for cryptographic JWT verification on the backend
# Retrieve from: Supabase Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET="your_supabase_jwt_secret_here"

# Application Internal JWT Secret (Used for signing & verifying internal user sessions)
JWT_SECRET="your_long_random_jwt_secret_min_32_characters_here"

# Razorpay Server Credentials (Required for payment order creation & HMAC verification)
RAZORPAY_KEY_ID="rzp_live_or_test_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# Additional Allowed Origins for CORS (Comma-separated)
ALLOWED_ORIGINS="https://krivio-ai.vercel.app,https://krivio.in"

# Meta WhatsApp Cloud API Credentials (Voice & Conversational Commerce Pipeline)
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_VERIFY_TOKEN="your_custom_secure_verify_token_for_meta_webhook"
WHATSAPP_APP_SECRET="your_meta_app_secret_for_signature_verification"
WHATSAPP_GRAPH_API_VERSION="v21.0"

# Google Cloud Speech-to-Text V2 / Chirp 2 (Indic Vernacular Voice Pipeline)
GOOGLE_CLOUD_PROJECT="your_google_cloud_project_id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/etc/secrets/google-credentials.json"
GOOGLE_SPEECH_API_KEY="your_google_speech_api_key_if_using_api_key_auth"
